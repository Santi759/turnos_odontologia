# Plantilla de variables de entorno LOCALES. Copiar a .env (copy .env.example .env).
# Solo valores ficticios de desarrollo (D1). No poner secretos ni credenciales reales.

# Servicio db (PostgreSQL de desarrollo)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=turnos

# Backend
DATABASE_URL=postgresql+psycopg://app:app@db:5432/turnos
# Base efimera y separada para pruebas de integracion y migraciones de prueba (servicio db-test)
TEST_DATABASE_URL=postgresql+psycopg://app:app@db-test:5432/turnos_test
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=local

# Frontend
VITE_API_BASE_URL=http://localhost:8000



# Autenticacion y sesiones
# Generar una clave real con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

# Valor ficticio: la aplicacion debe rechazarlo
AUTH_SECRET_KEY=REEMPLAZAR_generar_con_secrets_token_urlsafe_48

# Sesion
AUTH_SESSION_MINUTES=30
AUTH_SESSION_MAX_HOURS=12

# Cookies seguras por defecto
AUTH_COOKIE_SECURE=true

# Solo para desarrollo local con HTTP:
# AUTH_COOKIE_SECURE=false